<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_einvoice_purchase_line_company" model="ir.rule">
        <field name="name">AP invoice lines: allowed companies</field>
        <field name="model_id" ref="model_einvoice_purchase_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_purchase_value_company" model="ir.rule">
        <field name="name">AP invoice details: allowed companies</field>
        <field name="model_id" ref="model_einvoice_purchase_value"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_purchase_company" model="ir.rule">
        <field name="name">AP E-Invoices: allowed companies</field>
        <field name="model_id" ref="model_einvoice_purchase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
