<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_einvoice_log_list" model="ir.ui.view">
        <field name="name">einvoice.log.list</field>
        <field name="model">einvoice.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="call_datetime"/>
                <field name="direction"/>
                <field name="call_type"/>
                <field name="invoice_id" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="status_code"/>
                <field name="success" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_log_form" model="ir.ui.view">
        <field name="name">einvoice.log.form</field>
        <field name="model">einvoice.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="direction"/>
                        <field name="invoice_id" invisible="not invoice_id"/>
                        <field name="reference" invisible="not reference"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="call_type"/>
                        <field name="status_code"/>
                        <field name="success"/>
                        <field name="call_datetime"/>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_payload" class="o_field_text"/>
                        </page>
                        <page string="Response">
                            <field name="response_payload" class="o_field_text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_einvoice_log_search" model="ir.ui.view">
        <field name="name">einvoice.log.search</field>
        <field name="model">einvoice.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="invoice_id"/>
                <filter name="filter_ar" string="Sales (AR)" domain="[('direction', '=', 'ar')]"/>
                <filter name="filter_ap" string="Purchases (AP)" domain="[('direction', '=', 'ap')]"/>
                <separator/>
                <filter name="filter_failed" string="Failed" domain="[('success', '=', False)]"/>
                <filter name="filter_ok" string="Successful" domain="[('success', '=', True)]"/>
                <group>
                    <filter name="group_direction" string="Side" context="{'group_by': 'direction'}"/>
                    <filter name="group_call_type" string="Call Type" context="{'group_by': 'call_type'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'call_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_einvoice_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">einvoice.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_einvoice_log_search"/>
    </record>

</odoo>